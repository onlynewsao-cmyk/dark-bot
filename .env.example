# ═══════════════════════════════════════════════════════════════════════
# DARK BOT — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════════
# Copia este ficheiro para .env e preenche os valores
# cp .env.example .env
# Preenche SESSION_SECRET com um valor aleatório forte antes de iniciar.
# Os campos de credenciais ficam vazios de propósito; nunca os versionar.

# ── SERVIDOR ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=

# ── DONO (TU) ─────────────────────────────────────────────────────────
OWNER_NAME=Dark Net
OWNER_NUMBER=244923000000
OWNER_USERNAME=darknet
OWNER_PASSWORD=

# ── BOT ───────────────────────────────────────────────────────────────
BOT_NAME=DARK BOT
BOT_PREFIX=.
# Número do WhatsApp onde o bot está ligado (só dígitos). Este número é
# SUBDONO: pode executar qualquer comando a partir do próprio telemóvel.
BOT_NUMBER=244949000000

# ── MONGODB (OBRIGATÓRIO) ────────────────────────────────────────────
# Opção 1: MongoDB Atlas (GRATUITO) — https://www.mongodb.com/cloud/atlas
#   Cria conta → Create Cluster → Connect → Drivers → copia a URI
# Opção 2: MongoDB local — mongodb://localhost:27017/darkbot
MONGODB_URI=mongodb://localhost:27017/darkbot

# ── IA (PELO MENOS 1 OBRIGATÓRIO) ────────────────────────────────────
# Groq (GRATUITO, mais rápido) — https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (GRATUITO) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek (GRATUITO, 671B MoE, nível GPT-4) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenRouter (opcional) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── PERFORMANCE / SEGURANÇA ───────────────────────────────────────────
# Humanização (ver bloco HUMANIZE no fim; ON por padrão na v7.45+).
# Desligado por padrão: chamadas automáticas repetidas podem parecer spam.
AUTO_CALL=off
AUTO_CALL_MIN=30

# ── OPCIONAIS ─────────────────────────────────────────────────────────
# Canal WhatsApp (aparece no menu)
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbC8voN4Y9lszc9VuT2D

# ── DOWNLOADS (opcionais — sem isto o bot usa yt-dlp/fallbacks) ──────
# Instância Cobalt PRIVADA (a pública exige JWT) — melhora TikTok/IG/FB/Twitter/Spotify/SoundCloud
COBALT_API_URL=
COBALT_API_KEY=
# Cloudflare Worker próprio (proxy YouTube + social)
YT_PROXY_URL=
ENABLE_WORKER_SOCIAL=false

# GIFs das interações/medidores: 6 fontes gratuitas já funcionam SEM key
# (otakugifs, nekos.best, purrbot, waifu.pics, some-random-api, nekos.life).
# Tenor foi descontinuada pela Google; Giphy é opcional (mais variedade).
TENOR_API_KEY=
GIPHY_API_KEY=

# Cloudinary (para uploads de imagens)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# C∆P — sessão Instagram opcional, apenas para contas/conteúdos autorizados.
# Usa uma sessão própria e guarda-a no .env não versionado ou num secret manager.
# Nunca colocar cookies ou sessões reais neste ficheiro de exemplo.
IG_SESSIONID=

# C∆P — proxy residencial opcional (login por senha e 429 do IG); precisa: npm i https-proxy-agent
# CAP_PROXY=http://user:pass@proxy:porta
CAP_PROXY=

# v7.47 incoming-cases
# Free Fire (infoff/like) — token da Nyx Services (https://nyxlikesff.store)
NYX_FF_TOKEN=
# IA/alternativas zone.api.br (grok/fdc/nano-banana) — 'freekey' funciona
ZONE_API_KEY=freekey
# v7.45 — comportamento humano (lido, "a escrever…", atraso proporcional). on|off
HUMANIZE=on
HUMANIZE_CPS=40

# Participação AURA: contextual (padrão) = atenta, sem timer espontâneo.
# "Aura, interage com todos" abre conversa no grupo até pedires para parar ou dormir.
# proactive = restaura iniciativa por timer (respeita definições do dashboard).
AURA_PARTICIPATION=contextual

# Verificação explícita de informação com fontes (opcional)
TAVILY_API_KEY=

# Segurança e limites: deixar os modos destrutivos/debug desactivados.
# Em produção, SESSION_SECRET deve ser novo/aleatório (mínimo 32 caracteres); APP_URL deve ser a origem HTTPS real.
# AI_TOTAL_TIMEOUT_MS opcional: por defeito 12000 para prioridade e 15000 normal.
AI_PROVIDER_TIMEOUT_MS=5000
ENABLE_DEBUG_ENDPOINTS=false
ALLOW_LEGACY_RPG_RESET=false

# Respostas conversacionais antigas expiram; não é um timeout de todos os comandos.
AURA_REPLY_MAX_AGE_MS=60000
# Número de mensagens simultâneas (inválido/zero usa 8; máximo 32).
ROUTER_MAX_VOO=8

# Orçamento total da síntese de voz (ElevenLabs + fallback), máximo 20000 ms.
AURA_TTS_TIMEOUT_MS=12000
