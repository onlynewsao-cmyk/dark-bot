<%- include('../partials/head') %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <main class="main">

    <header class="page-header">
      <div>
        <h1>🔌 Connect &amp; Failover</h1>
        <p class="muted">Central única para ligação WhatsApp, QR/Pair Code, sessões de reserva e diagnóstico</p>
      </div>
      <div class="bot-status" id="botStatusBadge">
        <span class="status-dot status-<%= botState.status %>"></span>
        <span id="botStatusText"><%= botState.status %></span>
      </div>
    </header>

    <div class="alert alert-info" id="connInstructions">
      <span>💡</span>
      <span><strong>Como conectar:</strong> Escolha QR Code (escaneie pelo WhatsApp) ou Pair Code (digite no app). No Render, pode levar até 30s para aparecer.</span>
    </div>

    <div id="connectedBanner" style="display:none">
      <div class="alert alert-success">
        <span>✅</span>
        <span><strong>Bot conectado!</strong> WhatsApp está online e pronto.</span>
      </div>
    </div>

    <div class="card" style="margin-bottom:1.2rem">
      <div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap">
        <div>
          <h2 style="margin:0">⚙️ Controlo da sessão principal</h2>
          <p class="muted small" style="margin:.35rem 0 0">Reconectar mantém as credenciais. Reset apaga a sessão principal e as reservas.</p>
        </div>
        <div class="button-row">
          <button class="btn btn-secondary btn-sm" onclick="reconnectBot()">🔄 Reconectar</button>
          <button class="btn btn-danger btn-sm" onclick="disconnectBot()">🔌 Desconectar</button>
          <button class="btn btn-ghost btn-sm" onclick="resetBot()">🧹 Reset completo</button>
        </div>
      </div>
      <p class="muted small" id="sessionActionStatus" style="margin:.7rem 0 0"></p>
    </div>

    <div class="connect-grid">
      <!-- QR CODE -->
      <div class="card">
        <h2>📱 QR Code</h2>
        <p class="muted" style="margin-bottom:.75rem">Escaneie pelo WhatsApp → Aparelhos Conectados</p>

        <div class="qr-area" id="qrArea">
          <% if (botState.qr) { %>
            <img src="<%= botState.qr %>" alt="QR Code" id="qrImg" />
          <% } else if (botState.status === 'connected') { %>
            <div class="qr-placeholder success">
              <div class="qr-icon">✅</div>
              <p><strong>Conectado!</strong></p>
              <p class="muted small" style="margin-top:.3rem"><%= botState.user?.id?.split(':')[0] %></p>
            </div>
          <% } else { %>
            <div class="qr-placeholder">
              <div class="qr-icon">📱</div>
              <p>Clique em <strong>Gerar QR</strong></p>
            </div>
          <% } %>
        </div>

        <div class="button-row">
          <button class="btn btn-primary" id="btnQr" onclick="startQR()" <%= botState.status === 'connected' ? 'disabled' : '' %>>
            📱 Gerar QR Code
          </button>
          <% if (botState.status === 'connected') { %>
            <button class="btn btn-danger btn-sm" onclick="disconnectBot()">🔌 Desconectar</button>
          <% } %>
        </div>
      </div>

      <!-- PAIR CODE -->
      <div class="card">
        <h2>🔐 Pair Code</h2>
        <p class="muted" style="margin-bottom:.75rem">WhatsApp → Aparelhos Conectados → Vincular com número</p>

        <div class="form-group">
          <label>Número do WhatsApp (com DDI)</label>
          <input type="tel" id="pairNumber" placeholder="Ex: 244945280380" value="<%= owner.number %>" />
          <small class="muted">DDI + DDD + número. Sem + ou espaços.</small>
        </div>

        <div class="pair-area" id="pairArea">
          <% if (botState.pairingCode) { %>
            <div style="text-align:center">
              <div class="muted small" style="margin-bottom:.5rem">SEU PAIR CODE:</div>
              <div class="pair-code"><%= botState.pairingCode %></div>
              <div class="muted small" style="margin-top:.5rem">⏱️ Expira em ~3 minutos</div>
            </div>
          <% } else { %>
            <div class="qr-placeholder">
              <div class="qr-icon">🔐</div>
              <p>Clique em <strong>Gerar Pair Code</strong></p>
            </div>
          <% } %>
        </div>

        <button class="btn btn-success" id="btnPair" onclick="startPair()" <%= botState.status === 'connected' ? 'disabled' : '' %>>
          🔐 Gerar Pair Code
        </button>
      </div>
    </div>

    <!-- FAILOVER — integrado à central Connect -->
    <section id="failover" class="card" style="margin-top:1.2rem;border:1px solid rgba(0,240,255,.5)">
      <div style="display:flex;justify-content:space-between;align-items:start;gap:1rem;flex-wrap:wrap">
        <div>
          <h2 style="margin:0">🛟 Sessões de reserva / Failover</h2>
          <p class="muted" style="margin:.4rem 0 0">Adicione até 3 sessões de backup. Quando a principal cair, o failover testa a fila e promove a primeira sessão viva. Os slots não trocam de número.</p>
        </div>
        <div class="bot-status">
          <span class="status-dot status-<%= botState.status %>" id="failoverBotDot"></span>
          <span id="failoverBotStatus"><%= botState.status || '—' %></span>
        </div>
      </div>

      <div class="alert alert-info" style="margin-top:1rem">
        <span>🛡️</span>
        <span>O failover tenta uma reserva quando a sessão ativa expira, recebe restrição/403 ou falha repetidamente. Use <strong>Rodar agora</strong> apenas para testar ou assumir manualmente a próxima reserva viva.</span>
      </div>

      <form id="failoverAddForm" style="display:flex;gap:.6rem;flex-wrap:wrap;align-items:end;margin-top:1rem">
        <div class="form-group" style="margin:0;flex:1;min-width:220px">
          <label>Número de reserva (DDI + número)</label>
          <input type="tel" id="failoverNumber" placeholder="244912345678" autocomplete="off" />
        </div>
        <div class="form-group" style="margin:0;min-width:155px">
          <label>Slot</label>
          <select id="failoverSlot">
            <option value="">Automático</option>
            <% (slots || []).filter(s => s.slot > 1 && s.estado === 'vazia').forEach(s => { %>
              <option value="<%= s.slot %>">Slot <%= s.slot %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-primary" type="submit" id="btnFailoverAdd">🔑 Gerar Pair Code</button>
      </form>
      <p class="muted small" style="margin:.55rem 0 0">No WhatsApp do número de reserva: <em>Aparelhos ligados → Ligar com código</em>. A sessão fica guardada na fila, sem substituir a principal de imediato.</p>
      <p class="muted small" id="failoverAddStatus" style="margin:.55rem 0 0"></p>

      <div id="failoverPairBox" style="display:none;margin:1rem 0;text-align:center;padding:1rem;border:1px solid rgba(0,255,157,.45);border-radius:12px;background:rgba(0,255,157,.05)">
        <div class="muted small">PAIR CODE DA SESSÃO DE RESERVA</div>
        <div class="pair-code" id="failoverPairCode" style="margin:.55rem auto"></div>
        <div class="muted small" id="failoverPairTimer">Aguardando vínculo…</div>
      </div>

      <div id="failoverSlotsGrid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-top:1rem">
        <% const slotBadge = (estado) => estado === 'ativa' ? '🟢 EM USO' : estado === 'guardada' ? '🟦 NA FILA' : estado === 'ligacao' ? '⏳ A LIGAR' : estado === 'morta' ? '⛔ INDISPONÍVEL' : '⬜ VAZIA'; %>
        <% (slots || []).forEach(s => { %>
          <div class="card" style="margin:0;border:1px solid <%= s.estado === 'ativa' ? '#00ff9d' : s.estado === 'guardada' ? '#00f0ff' : s.estado === 'ligacao' ? '#ffd166' : s.estado === 'morta' ? '#ff4d6d' : '#444' %>">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem">
              <h3 style="margin:0">SLOT <%= s.slot %></h3>
              <span class="badge"><%= slotBadge(s.estado) %><%= s.proxima ? ' · PRÓXIMA' : '' %></span>
            </div>
            <p style="margin:.65rem 0 .25rem"><strong><%= s.numero %></strong></p>
            <p class="muted small" style="margin:0">
              <% if (s.ultimaViva) { %>Viva: <%= new Date(s.ultimaViva).toLocaleString('pt-PT') %><br><% } %>
              <% if (s.ultimaProva) { %>Teste: <%= new Date(s.ultimaProva).toLocaleString('pt-PT') %><br><% } %>
              <% if (s.motivo) { %>⚠️ <%= s.motivo %><br><% } %>
              <% if (s.emRetry) { %>🔁 Tentativas: <%= s.tentativas %><% } %>
            </p>
            <% if (s.slot !== 1 && s.estado !== 'vazia') { %>
              <div class="button-row" style="margin-top:.75rem"><button class="btn btn-danger btn-sm" onclick="removeFailoverSlot(<%= s.slot %>)">🗑️ Remover</button></div>
            <% } %>
          </div>
        <% }) %>
      </div>

      <div class="button-row" style="margin-top:1rem">
        <button class="btn btn-secondary" onclick="runFailoverNow()">🔁 Rodar failover agora</button>
        <button class="btn btn-ghost" onclick="refreshFailover(false)">🔄 Atualizar sessões</button>
      </div>
      <p class="muted small" id="failoverOperationStatus" style="margin:.65rem 0 0"></p>
    </section>

    <!-- CHAMADAS DE VOZ (VoIP no socket principal — v7.43+) -->
    <div class="card" style="margin-top:1.2rem;border:1px solid #06B6D4">
      <h2>📞 Chamadas de Voz (VoIP)</h2>
      <p class="muted" style="margin-bottom:.75rem">
        Usa a <strong>mesma sessão</strong> do bot principal — sem QR extra, sem 2.º/3.º aparelho.
        Só o Dono pode pedir (<code>.call</code> / "aura liga-me"). Limites anti-restrição:
        1 chamada de cada vez · máx. <span id="voipMaxMin">20</span> min · <span id="voipCooldown">2</span> min entre chamadas · <span id="voipPorHora">6</span>/hora.
      </p>
      <div class="bot-status" style="margin-bottom:.75rem">
        <span class="status-dot status-off" id="voipStatusDot"></span>
        <span id="voipStatusText">a carregar…</span>
      </div>
      <div id="voipCallsList" class="muted small">Sem chamadas activas.</div>
      <div class="qr-actions" style="margin-top:.75rem">
        <button class="btn btn-danger btn-sm" id="btnVoipHangup" onclick="voipHangupAll()" style="display:none">🔴 Desligar todas</button>
      </div>
      <div id="voipRestrictedWarn" style="display:none;margin-top:.75rem;padding:.6rem .8rem;border:1px solid #f43f5e;border-radius:10px;color:#fda4af">
        ⛔ Conta <strong>restrita</strong> pela Meta. Não faças chamadas/broadcast até a restrição sair; o bot volta a ligar-se sozinho (espera 15 min entre tentativas).
      </div>
    </div>


    <!-- LOG DE CONEXÃO -->
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.85rem">
        <h2 style="margin-bottom:0">📡 Log de Conexão</h2>
        <button class="btn btn-sm btn-ghost" onclick="clearLog()">🗑️ Limpar</button>
      </div>
      <div class="console" id="connLog" style="height:200px">
        <% (botState.recentLogs || []).slice(-20).forEach(l => { %>
          <div class="console-line log-<%= l.level %>">
            <span class="console-time">[<%= new Date(l.time).toLocaleTimeString('pt-BR') %>]</span>
            <%= l.message %>
          </div>
        <% }) %>
        <% if (!botState.recentLogs?.length) { %>
          <div class="console-line muted">Aguardando logs...</div>
        <% } %>
      </div>
    </div>

  </main>
</div>


<script>
  const connectSocket = (typeof io !== 'undefined') ? (window.darkBotSocket || io({ reconnection: true })) : null;
  if (connectSocket) window.darkBotSocket = connectSocket;
  const statusText = document.getElementById('botStatusText');
  const statusDot = document.querySelector('#botStatusBadge .status-dot');
  const qrArea = document.getElementById('qrArea');
  const pairArea = document.getElementById('pairArea');
  const connLog = document.getElementById('connLog');
  const connectedBanner = document.getElementById('connectedBanner');
  const connInstructions = document.getElementById('connInstructions');

  let fastPollTimer = null;
  let lastQr = '';
  let lastPair = '';
  let lastStatusLog = '';

  function addLog(level, msg) {
    if (!connLog) return;
    const t = new Date().toLocaleTimeString('pt-BR');
    const d = document.createElement('div');
    d.className = `console-line log-${level}`;
    const safe = String(msg).replace(/</g,'&lt;').replace(/>/g,'&gt;');
    d.innerHTML = `<span class="console-time">[${t}]</span> ${safe}`;
    connLog.appendChild(d);
    connLog.scrollTop = connLog.scrollHeight;
    if (connLog.children.length > 80) connLog.removeChild(connLog.firstChild);
  }

  function clearLog() {
    if (connLog) connLog.innerHTML = '<div class="console-line muted">Log limpo.</div>';
  }

  function setButtons({ qrDisabled = false, pairDisabled = false, qrText = '📱 Gerar QR Code', pairText = '🔐 Gerar Pair Code' } = {}) {
    const qr = document.getElementById('btnQr');
    const pair = document.getElementById('btnPair');
    if (qr) { qr.disabled = qrDisabled; qr.textContent = qrText; }
    if (pair) { pair.disabled = pairDisabled; pair.textContent = pairText; }
  }

  function resetConnectButtons() {
    setButtons();
  }

  function setStatusBadge(status) {
    if (statusText) statusText.textContent = status;
    if (statusDot) statusDot.className = 'status-dot status-' + status;
  }

  function renderBotStatus(data = {}, silent = false) {
    if (!data.status) return;
    const s = data.status;
    const err = data.error || data.lastError || data.message || '';
    setStatusBadge(s);

    if (s === 'connected') {
      if (connectedBanner) connectedBanner.style.display = 'block';
      if (connInstructions) connInstructions.style.display = 'none';
      setButtons({ qrDisabled: true, pairDisabled: true });
      qrArea.innerHTML = `<div class="qr-placeholder success"><div class="qr-icon">✅</div><p><strong>Conectado!</strong></p><p class="muted small">${data.user?.id || ''}</p></div>`;
      pairArea.innerHTML = `<div class="qr-placeholder success"><div class="qr-icon">✅</div><p><strong>Ativo!</strong></p></div>`;
      if (!silent && lastStatusLog !== 'connected') toast('✅ Bot conectado ao WhatsApp!', 'success', 4000);
      lastStatusLog = 'connected';
      return;
    }

    if (s === 'qr') {
      if (data.qr && data.qr !== lastQr) {
        lastQr = data.qr;
        qrArea.innerHTML = `<img src="${data.qr}" alt="QR Code" style="max-width:240px;border-radius:12px;background:white;padding:10px" />`;
        addLog('success', '📱 QR Code gerado — escaneie agora!');
        if (!silent) toast('📱 QR Code pronto — escaneie!', 'success');
      }
      setButtons({ qrText: '🔄 Gerar novo QR', pairText: '🔐 Gerar Pair Code' });
      return;
    }

    // v12.9.27: um pair code publicado pela CENTRAL (outros slots) aparece AQUI também —
    // mesma verdade nas duas páginas, sem depender do status do socket principal
    if (s !== 'pairing' && data.pairingCode && data.pairingCode !== lastPair) {
      lastPair = data.pairingCode;
      pairArea.innerHTML = `<div style="text-align:center">
        <div class="muted small">PAIR CODE — NOVO SLOT (Central de Sessões):</div>
        <div class="pair-code">${data.pairingCode}</div>
        <div class="muted small" style="margin-top:.5rem">Abra o WhatsApp desse número → Aparelhos conectados → Vincular com número → digite o código.</div>
      </div>`;
      addLog('success', `🔐 Pair Code (slot da Central): ${data.pairingCode}`);
    }

    if (s === 'pairing') {
      if (data.pairingCode && data.pairingCode !== lastPair) {
        lastPair = data.pairingCode;
        pairArea.innerHTML = `<div style="text-align:center">
          <div class="muted small">SEU PAIR CODE:</div>
          <div class="pair-code">${data.pairingCode}</div>
          <div class="muted small" style="margin-top:.5rem">Abra o WhatsApp do número escolhido → Aparelhos conectados → Vincular com número → digite este código.</div>
          <div class="muted small">⏱️ Expira em ~3 min</div>
        </div>`;
        addLog('success', `🔐 Pair Code gerado: ${data.pairingCode}`);
        if (!silent) toast(`🔐 Pair Code: ${data.pairingCode}`, 'success', 8000);
      } else if (!data.pairingCode) {
        pairArea.innerHTML = `<div class="qr-placeholder"><div class="spinner"></div><p>Solicitando pair code...</p><p class="muted small">Pode levar alguns segundos no Render.</p></div>`;
      }
      setButtons({ qrText: '📱 Gerar QR Code', pairText: '🔄 Gerar novo Pair Code' });
      return;
    }

    if (s === 'connecting') {
      qrArea.innerHTML = `<div class="qr-placeholder"><div class="spinner"></div><p>Conectando...</p><p class="muted small">Aguardando resposta do WhatsApp...</p></div>`;
      if (!silent && lastStatusLog !== 'connecting') addLog('info', '🔄 Conectando ao WhatsApp...');
      lastStatusLog = 'connecting';
      setButtons({ qrDisabled: true, pairDisabled: true, qrText: '⏳ Aguarde...', pairText: '⏳ Aguarde...' });
      return;
    }

    if (s === 'disconnected') {
      if (err && !silent) addLog('warn', `⚠️ Desconectado: ${err}`);
      if (err) {
        qrArea.innerHTML = `<div class="qr-placeholder"><div class="qr-icon">⚠️</div><p>Não conectado</p><p class="muted small">${String(err).replace(/</g,'&lt;')}</p></div>`;
      }
      resetConnectButtons();
    }
  }

  async function refreshStatus(silent = true) {
    try {
      const r = await fetch('/api/bot/status', { cache: 'no-store' });
      const data = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(data.error || `HTTP ${r.status}`);
      renderBotStatus(data, silent);
      return data;
    } catch (e) {
      if (!silent) {
        addLog('error', '❌ Falha ao consultar status: ' + e.message);
        toast(e.message, 'error');
      }
      return null;
    }
  }

  function startFastPolling(seconds = 90) {
    if (fastPollTimer) clearInterval(fastPollTimer);
    refreshStatus(false);
    const stopAt = Date.now() + seconds * 1000;
    fastPollTimer = setInterval(() => {
      refreshStatus(true);
      if (Date.now() > stopAt) {
        clearInterval(fastPollTimer);
        fastPollTimer = null;
        resetConnectButtons();
      }
    }, 2000);
  }

  if (connectSocket) {
    connectSocket.on('connect', () => addLog('info', '🔌 Socket conectado ao servidor'));
    connectSocket.on('bot:status', (data) => renderBotStatus(data, false));
    connectSocket.on('bot:log', (data) => addLog(data.level || 'info', data.message));
    connectSocket.on('bot:error', (data) => {
      addLog('error', '❌ ' + data.message);
      toast(data.message, 'error');
      resetConnectButtons();
    });
  } else {
    addLog('warn', 'Socket.IO não carregou; usando atualização por polling.');
  }

  async function postJSON(url, body = null) {
    const opts = { method: 'POST', headers: {'Content-Type':'application/json'} };
    if (body) opts.body = JSON.stringify(body);
    const r = await fetch(url, opts);
    let data = {};
    try { data = await r.json(); } catch (_) {}
    if (!r.ok) throw new Error(data.error || `Erro HTTP ${r.status}`);
    return data;
  }

  async function startQR() {
    const btn = document.getElementById('btnQr');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ Aguarde...'; }
    qrArea.innerHTML = `<div class="qr-placeholder"><div class="spinner"></div><p>Gerando QR Code...</p><p class="muted small">Aguarde até 30 segundos.</p></div>`;
    addLog('info', '🔄 Iniciando nova sessão com QR Code...');
    try {
      await postJSON('/api/bot/start', { mode: 'qr', fresh: true });
      addLog('info', '✅ Pedido enviado ao servidor. Aguardando QR Code...');
      startFastPolling(120);
    } catch(e) {
      addLog('error', '❌ ' + e.message);
      toast(e.message, 'error');
      resetConnectButtons();
    }
  }

  async function startPair() {
    const num = document.getElementById('pairNumber')?.value?.replace(/\D/g, '');
    if (!num || num.length < 10) { toast('❌ Número inválido (mín. 10 dígitos com DDI)', 'error'); return; }
    const btn = document.getElementById('btnPair');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ Aguarde...'; }
    pairArea.innerHTML = `<div class="qr-placeholder"><div class="spinner"></div><p>Gerando código...</p><p class="muted small">Aguarde a resposta do WhatsApp.</p></div>`;
    addLog('info', `🔐 Solicitando pair code para ${num}...`);
    try {
      await postJSON('/api/bot/start', { mode: 'pair', phoneNumber: num, fresh: true });
      addLog('info', '✅ Pedido enviado ao servidor. Aguardando pair code...');
      startFastPolling(120);
    } catch(e) {
      addLog('error', '❌ ' + e.message);
      toast(e.message, 'error');
      resetConnectButtons();
    }
  }

  async function disconnectBot() {
    if (!confirm('Desconectar o bot do WhatsApp?')) return;
    try {
      await postJSON('/api/bot/logout');
      toast('🔌 Bot desconectado.', 'warn');
      resetConnectButtons();
      refreshStatus(false);
    } catch(e) { toast(e.message, 'error'); }
  }

  function setSessionActionStatus(text, kind = '') {
    const el = document.getElementById('sessionActionStatus');
    if (!el) return;
    el.textContent = text;
    el.style.color = kind === 'error' ? 'var(--neon-red)' : kind === 'success' ? 'var(--neon-green)' : '';
  }

  async function reconnectBot() {
    setSessionActionStatus('⏳ Solicitando reconexão sem apagar as credenciais…');
    try {
      const r = await postJSON('/api/control/reconnect');
      setSessionActionStatus(r.message || '🔄 Reconexão iniciada.', 'success');
      startFastPolling(120);
    } catch (e) { setSessionActionStatus('❌ ' + e.message, 'error'); }
  }

  async function resetBot() {
    if (!confirm('Reset completo? Isto apaga a sessão principal e todas as sessões de reserva.')) return;
    setSessionActionStatus('⏳ Limpando credenciais…');
    try {
      await postJSON('/api/bot/reset');
      setSessionActionStatus('✅ Sessões removidas. Gere um novo QR ou Pair Code.', 'success');
      resetConnectButtons();
      refreshStatus(false);
      refreshFailover(true);
    } catch (e) { setSessionActionStatus('❌ ' + e.message, 'error'); }
  }

  // ══════════════ Failover / sessões de reserva ══════════════
  const FAILOVER_BADGE = { ativa: '🟢 EM USO', guardada: '🟦 NA FILA', ligacao: '⏳ A LIGAR', morta: '⛔ INDISPONÍVEL', vazia: '⬜ VAZIA' };
  const FAILOVER_COLOR = { ativa: '#00ff9d', guardada: '#00f0ff', ligacao: '#ffd166', morta: '#ff4d6d', vazia: '#444' };
  let failoverPairTimer = null;
  let lastFailoverPair = '';

  function escapeHtml(value) {
    return String(value == null ? '' : value).replace(/[&<>'"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[c]));
  }
  function failoverDate(value) { return value ? new Date(value).toLocaleString('pt-PT') : ''; }
  function setFailoverStatus(id, text, kind = '') {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = text;
    el.style.color = kind === 'error' ? 'var(--neon-red)' : kind === 'success' ? 'var(--neon-green)' : '';
  }
  function renderFailoverSlots(slots) {
    const grid = document.getElementById('failoverSlotsGrid');
    if (!grid || !Array.isArray(slots)) return;
    grid.innerHTML = slots.map(s => {
      const canRemove = s.slot !== 1 && s.estado !== 'vazia';
      const detail = [
        s.ultimaViva && 'Viva: ' + failoverDate(s.ultimaViva),
        s.ultimaProva && 'Teste: ' + failoverDate(s.ultimaProva),
        s.motivo && '⚠️ ' + s.motivo,
        s.emRetry && '🔁 Tentativas: ' + (s.tentativas || 0),
      ].filter(Boolean).map(escapeHtml).join('<br>');
      return '<div class="card" style="margin:0;border:1px solid ' + (FAILOVER_COLOR[s.estado] || '#444') + '">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem">' +
        '<h3 style="margin:0">SLOT ' + Number(s.slot) + '</h3><span class="badge">' + escapeHtml(FAILOVER_BADGE[s.estado] || s.estado) + (s.proxima ? ' · PRÓXIMA' : '') + '</span></div>' +
        '<p style="margin:.65rem 0 .25rem"><strong>' + escapeHtml(s.numero || '(sem número)') + '</strong></p>' +
        '<p class="muted small" style="margin:0">' + detail + '</p>' +
        (canRemove ? '<div class="button-row" style="margin-top:.75rem"><button class="btn btn-danger btn-sm" onclick="removeFailoverSlot(' + Number(s.slot) + ')">🗑️ Remover</button></div>' : '') +
      '</div>';
    }).join('');

    const select = document.getElementById('failoverSlot');
    if (select) {
      const selected = select.value;
      select.innerHTML = '<option value="">Automático</option>' + slots.filter(s => s.slot > 1 && s.estado === 'vazia')
        .map(s => '<option value="' + Number(s.slot) + '">Slot ' + Number(s.slot) + '</option>').join('');
      if ([...select.options].some(o => o.value === selected)) select.value = selected;
    }
  }
  function showFailoverPair(slot, code, timeoutMs = 90000) {
    if (!code) return;
    lastFailoverPair = code;
    const box = document.getElementById('failoverPairBox');
    const codeEl = document.getElementById('failoverPairCode');
    const timerEl = document.getElementById('failoverPairTimer');
    if (!box || !codeEl || !timerEl) return;
    box.style.display = 'block';
    codeEl.textContent = code;
    const until = Date.now() + Number(timeoutMs || 90000);
    try { sessionStorage.setItem('darkFailoverPair', JSON.stringify({ slot, code, until })); } catch {}
    clearInterval(failoverPairTimer);
    failoverPairTimer = setInterval(() => {
      const seconds = Math.max(0, Math.ceil((until - Date.now()) / 1000));
      timerEl.textContent = seconds ? 'Slot ' + slot + ' · aguardando vínculo (' + seconds + 's)' : 'Código expirado — gere outro se ainda não vinculou.';
      if (!seconds) clearInterval(failoverPairTimer);
    }, 1000);
    timerEl.textContent = 'Slot ' + slot + ' · aguardando vínculo…';
  }
  async function refreshFailover(silent = true) {
    try {
      const r = await fetch('/dashboard/connect/status.json', { cache: 'no-store' });
      const data = await r.json().catch(() => ({}));
      if (!r.ok || !data.ok) throw new Error(data.error || 'Não foi possível atualizar o failover');
      renderFailoverSlots(data.slots || []);
      const dot = document.getElementById('failoverBotDot');
      const text = document.getElementById('failoverBotStatus');
      if (dot) dot.className = 'status-dot status-' + (data.bot?.status || 'disconnected');
      if (text) text.textContent = data.bot?.status || '—';
      const pairing = (data.slots || []).find(s => s.estado === 'ligacao' && s.codigo);
      if (pairing && pairing.codigo !== lastFailoverPair) showFailoverPair(pairing.slot, pairing.codigo);
      if (!pairing) { try { sessionStorage.removeItem('darkFailoverPair'); } catch {} }
      return data;
    } catch (e) {
      if (!silent) setFailoverStatus('failoverOperationStatus', '❌ ' + e.message, 'error');
      return null;
    }
  }
  document.getElementById('failoverAddForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const number = String(document.getElementById('failoverNumber')?.value || '').replace(/\D/g, '');
    const slot = document.getElementById('failoverSlot')?.value || null;
    if (number.length < 8) { setFailoverStatus('failoverAddStatus', '❌ Informe o número com DDI.', 'error'); return; }
    const button = document.getElementById('btnFailoverAdd');
    if (button) { button.disabled = true; button.textContent = '⏳ Gerando…'; }
    setFailoverStatus('failoverAddStatus', '⏳ Abrindo sessão de reserva e pedindo o código ao WhatsApp…');
    try {
      const result = await postJSON('/dashboard/connect/failover/adicionar', { numero: number, slot });
      if (!result.ok) throw new Error(result.motivo || 'Não foi possível gerar o Pair Code');
      showFailoverPair(result.slot, result.codigo, result.timeoutMs);
      setFailoverStatus('failoverAddStatus', '✅ Slot ' + result.slot + ' pronto para vínculo.', 'success');
      document.getElementById('failoverNumber').value = '';
      refreshFailover(true);
    } catch (e) { setFailoverStatus('failoverAddStatus', '❌ ' + e.message, 'error'); }
    finally { if (button) { button.disabled = false; button.textContent = '🔑 Gerar Pair Code'; } }
  });
  async function removeFailoverSlot(slot) {
    if (!confirm('Remover a sessão de reserva do slot ' + slot + '?')) return;
    setFailoverStatus('failoverOperationStatus', '⏳ Removendo slot ' + slot + '…');
    try {
      const result = await postJSON('/dashboard/connect/failover/remover/' + Number(slot));
      if (!result.ok) throw new Error(result.motivo || 'Não foi possível remover o slot');
      setFailoverStatus('failoverOperationStatus', '✅ Slot ' + slot + ' removido.', 'success');
      refreshFailover(true);
    } catch (e) { setFailoverStatus('failoverOperationStatus', '❌ ' + e.message, 'error'); }
  }
  async function runFailoverNow() {
    if (!confirm('Testar a fila e promover a primeira sessão de reserva viva?')) return;
    setFailoverStatus('failoverOperationStatus', '⏳ Testando sessões guardadas…');
    try {
      const result = await postJSON('/dashboard/connect/failover/rodar');
      if (!result.ok) throw new Error(result.motivo === 'sem-suplente-viva' ? 'Nenhuma sessão de reserva respondeu.' : (result.motivo || 'Failover não executado'));
      setFailoverStatus('failoverOperationStatus', '✅ Slot ' + result.promovida + ' (' + (result.numero || '?') + ') assumiu a sessão principal.', 'success');
      setTimeout(() => { refreshFailover(true); refreshStatus(true); }, 2500);
    } catch (e) { setFailoverStatus('failoverOperationStatus', '❌ ' + e.message, 'error'); }
  }

  // ══════════════ Chamadas de Voz (VoIP no socket principal) ══════════════
  function renderVoip(data = {}) {
    const dot = document.getElementById('voipStatusDot');
    const txt = document.getElementById('voipStatusText');
    const list = document.getElementById('voipCallsList');
    const btn = document.getElementById('btnVoipHangup');
    const warn = document.getElementById('voipRestrictedWarn');
    if (!dot || !txt) return;
    const bot = data.bot || 'disconnected';
    const restrito = bot === 'restricted';
    let s = 'off', label = 'Bot offline — chamadas indisponíveis';
    if (restrito) { s = 'restricted'; label = 'Conta restrita — chamadas bloqueadas'; }
    else if (bot === 'connected' && data.suportado === false) { s = 'disconnected'; label = 'Lib sem suporte VoIP (npm ci)'; }
    else if (bot === 'connected') { s = data.activas?.length ? 'connected' : 'qr'; label = data.activas?.length ? `${data.activas.length} chamada(s) activa(s)` : 'Pronto — .call para ligar'; }
    dot.className = 'status-dot status-' + s; txt.textContent = label;
    if (warn) warn.style.display = restrito ? '' : 'none';
    if (data.limites) {
      const $ = id => document.getElementById(id);
      if ($('voipMaxMin')) $('voipMaxMin').textContent = Math.round(data.limites.maxDuracaoMs / 60000);
      if ($('voipCooldown')) $('voipCooldown').textContent = Math.round(data.limites.cooldownMs / 60000);
      if ($('voipPorHora')) $('voipPorHora').textContent = data.limites.maxPorHora;
    }
    const act = data.activas || [];
    if (btn) btn.style.display = act.length ? '' : 'none';
    if (list) {
      list.innerHTML = act.length ? act.map(a => {
        const dur = Math.floor((Date.now() - a.desde) / 1000);
        const m = String(Math.floor(dur / 60)).padStart(2, '0'), sec = String(dur % 60).padStart(2, '0');
        return `<div>📞 <strong>${a.jid.split('@')[0]}</strong>${a.grupo ? ' (grupo)' : ''} · ${m}:${sec}${a.tocando ? ' · 🎵 a tocar' : ''}</div>`;
      }).join('') : 'Sem chamadas activas.';
    }
  }
  async function refreshVoip() {
    try { const r = await fetch('/api/voip/calls', { cache: 'no-store' }); renderVoip(await r.json().catch(() => ({}))); } catch {}
  }
  async function voipHangupAll() {
    if (!confirm('Desligar todas as chamadas activas?')) return;
    try { await postJSON('/api/voip/hangup'); toast('📞 Chamadas desligadas.', 'warn'); refreshVoip(); }
    catch (e) { toast(e.message, 'error'); }
  }


  // Polling leve permanente: se WebSocket falhar no Render, a página continua atualizando.
  setInterval(() => refreshStatus(true), 5000);
  setInterval(refreshVoip, 5000);
  setInterval(() => refreshFailover(true), 15000);
  try {
    const savedPair = JSON.parse(sessionStorage.getItem('darkFailoverPair') || 'null');
    if (savedPair?.until > Date.now()) showFailoverPair(savedPair.slot, savedPair.code, savedPair.until - Date.now());
  } catch {}
  refreshVoip();
  refreshStatus(true);
  refreshFailover(true);
</script>
